{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate-countries": "node scripts/generate-countries.js",
    "enrich-languages": "node scripts/enrich-country-languages.js",
    "enrich-gdp": "node scripts/enrich-country-gdp.js",
    "enrich-religions": "node scripts/enrich-country-religions.js",
    "generate-globe-map": "node scripts/generate-globe-map.js",
    "generate-pronunciations": "node --env-file=../../.env scripts/generate-pronunciations.js",
    "generate-capital-pronunciations": "node --env-file=../../.env scripts/generate-capital-pronunciations.js",
    "db:setup": "node --env-file=../../.env scripts/setup-db.js",
    "db:collapse-levels": "node --env-file=../../.env scripts/collapse-country-stats-levels.js",
    "test:learn": "node --import ./scripts/register-alias.mjs --test scripts/test-learn-mode.js scripts/test-saved-learn-session.js scripts/test-worldly-score.js scripts/test-collapse-level-rows.js",
    "test:recency": "node --import ./scripts/register-alias.mjs --test scripts/test-recency.js",
    "test:labels": "node --test scripts/test-discover-label-visibility.js scripts/test-discover-label-layout.js",
    "test:territories": "node --import ./scripts/register-alias.mjs --test scripts/test-discover-territories.js",
    "test:pacific": "node --test scripts/test-pacific-islands.js",
    "test:subscription": "node --import ./scripts/register-alias.mjs --test scripts/test-daily-limit.js",
    "test": "npm run test:learn && npm run test:recency && npm run test:labels && npm run test:territories && npm run test:pacific && npm run test:subscription",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "stripe:trigger-update": "stripe trigger customer.subscription.updated"
  },
  "dependencies": {
    "@worldly/api-client": "*",
    "@worldly/constants": "*",
    "@worldly/core": "*",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "mapbox-gl": "^3.9.4",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.16.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.14.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "^3.848.0",
    "@tailwindcss/postcss": "^4.3.1",
    "tailwindcss": "^4.3.1"
  }
}
