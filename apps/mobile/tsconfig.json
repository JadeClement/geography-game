{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@worldly/core": [
        "../../packages/core/index.js"
      ],
      "@worldly/core/*": [
        "../../packages/core/*"
      ],
      "@worldly/constants": [
        "../../packages/constants/index.js"
      ],
      "@worldly/api-client": [
        "../../packages/api-client/index.js"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
